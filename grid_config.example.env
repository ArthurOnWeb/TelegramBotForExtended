# Grid Trading Strategy Configuration
# Copy this file to .env and adjust values as needed

# API Credentials (required)
API_KEY=your_api_key_here
PUBLIC_KEY=your_public_key_here
PRIVATE_KEY=your_private_key_here
VAULT=your_vault_id_here

# Market Configuration
GRID_MARKET=ETH-USD

# Grid Parameters
GRID_MIN_PRICE=2500.00
GRID_MAX_PRICE=3500.00
GRID_LEVELS=10
GRID_ORDER_USD=100

# Risk Management
GRID_MAX_POSITION_USD=1000
GRID_REBALANCE_THRESHOLD=0.01

# Performance Settings
GRID_REFRESH_INTERVAL=1.0
GRID_MAX_ORDER_AGE=300

# Logging
LOG_LEVEL=INFO

# Example configurations for different markets:
# BTC-USD: GRID_MIN_PRICE=40000, GRID_MAX_PRICE=50000, GRID_LEVELS=20
# ETH-USD: GRID_MIN_PRICE=2500, GRID_MAX_PRICE=3500, GRID_LEVELS=15
# SOL-USD: GRID_MIN_PRICE=80, GRID_MAX_PRICE=120, GRID_LEVELS=8